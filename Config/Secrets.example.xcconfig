// Copy to Config/Secrets.xcconfig and fill in. That file is gitignored.
//
// Note: xcconfig treats "//" as the start of a comment, so values can't contain it.

// Your Apple Developer Team ID (Xcode > Settings > Accounts, or developer.apple.com > Membership).
DEVELOPMENT_TEAM = ABCDE12345

// Reverse-DNS prefix you own. Bundle ID becomes <prefix>.eightytwenty and the
// iCloud container becomes iCloud.<prefix>.eightytwenty.
BUNDLE_ID_PREFIX = com.yourname

// From cloud.ouraring.com/oauth/applications. Register the redirect URI
// eightytwenty://oauth-callback for your app there.
OURA_CLIENT_ID = your-client-id
OURA_CLIENT_SECRET = your-client-secret

// No paid Apple Developer account yet? Uncomment to build without iCloud sync.
// Your data then lives only on this phone (plus the backups you export), so
// don't stay in this mode long.
// CODE_SIGN_ENTITLEMENTS = App/EightyTwenty-NoCloud.entitlements
